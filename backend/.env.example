APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
# Local default. Production accepts postgres:// or postgresql:// Supabase URLs.
DATABASE_URL=sqlite:///./data/ledgerly.db
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=20
ACCESS_TOKEN_MINUTES=1440

# Business-data warehouse. Ledgerly keeps the current storage path active until
# these credentials are complete, then routes uploads, Pulse, chat, and reports
# through Snowflake without changing API contracts.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=LEDGERLY_WH
SNOWFLAKE_DATABASE=LEDGERLY
SNOWFLAKE_SCHEMA=BUSINESS
SNOWFLAKE_ROLE=
