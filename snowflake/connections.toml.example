# Copy the profiles you need into ~/.snowflake/connections.toml.
# Prefer browser SSO for local CoCo usage; never commit credentials or tokens.
#
# Use this profile only for the first bootstrap. It intentionally does not name
# Ledgerly objects because they do not exist until setup.sql has completed.
[ledgerly-bootstrap]
account = "<organization-account>"
user = "<username>"
authenticator = "externalbrowser"
role = "ACCOUNTADMIN"

# Use this least-privilege profile after setup.sql has completed and
# LEDGERLY_APP_ROLE has been granted to this user.
[ledgerly]
account = "<organization-account>"
user = "<username>"
authenticator = "externalbrowser"
warehouse = "LEDGERLY_WH"
database = "LEDGERLY"
schema = "BUSINESS"
role = "LEDGERLY_APP_ROLE"
